{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Biker 4X",
  "version": "0.2.0",
  "identifier": "dev.itomaselli.biker4x",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Biker 4X",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "4X por turnos sobre un club de motoqueros",
    "copyright": "Gráficos: 1-Bit Pack de Kenney (CC0)"
  }
}
