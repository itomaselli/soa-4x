{
  "name": "biker-4x",
  "version": "0.5.0",
  "description": "Juego 4X por turnos semanales sobre un club de motoqueros",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "sim": "tsx src/cli/sim.ts",
    "play": "tsx src/cli/play.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:icon": "python3 scripts/make-icon.py && tauri icon assets/icon/icon-source.png"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "pixi.js": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
